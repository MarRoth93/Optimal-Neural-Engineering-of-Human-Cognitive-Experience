# ============================================
# Ignore everything by default
# ============================================
*

# ============================================
# Allow essential project files
# ============================================
!.gitignore
!README.md
!environment.yml

# ============================================
# Allow scripts directories
# ============================================
!scripts/
!scripts/*.py
!scripts/analysis/
!scripts/analysis/*.py
!scripts/analysis/*.ipynb

!slurm_scripts/
!slurm_scripts/*.sh
!slurm_scripts/analysis/
!slurm_scripts/analysis/*.sh

# ============================================
# Allow results/graphs directory
# ============================================
!results/
!results/graphs/
!results/graphs/**

# ============================================
# Ignore unwanted subdirectories in scripts
# ============================================
scripts/redundant/
scripts/alignment/
scripts/analysis/redundant_scripts/
slurm_scripts/alignment/
slurm_scripts/analysis/redundant_scripts/

# ============================================
# Always ignore these patterns everywhere
# ============================================

# Python cache / bytecode
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter checkpoints
**/.ipynb_checkpoints/

# Logs
**/logs/

# Virtual environments
.venv/
venv/
env/

# Data directories (large files)
data/
figures/
flatmaps/

# Ignore other results subdirectories (but not graphs - allowed above)
results/assessor_scores/
results/metrics/
results/nifti/
results/statistics/
results/thetas/
results/vdvae/
results/versatile_diffusion/

# External dependencies
vdvae/
versatile_diffusion/
assessors/
freesurfer/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
