# — Ignore everything by default —
*
!README.md

# — But allow the scripts, slurm_scripts, results directories —
!scripts/
!slurm_scripts/
!results/
!results/graphs/
!results/metrics/

# — And everything inside them —
!scripts/**
!slurm_scripts/**
!results/graphs/**
!results/metrics/**

# Ignore freesurfer entirely
freesurfer/

# — Still ignore unwanted stuff inside other folders —
**/.ipynb_checkpoints/
scripts/**/.ipynb_checkpoints/
slurm_scripts/**/.ipynb_checkpoints/

# Logs (everywhere) & specifically slurm_scripts/analysis/logs/
**/logs/
slurm_scripts/analysis/logs/

# Python cache / bytecode
__pycache__/
*.pyc
*.pyo
